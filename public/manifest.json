{
  "manifest_version": 3,
  "name": "YouTube Learning Companion",
  "version": "0.1.0",
  "description": "Turn YouTube educational videos into an interactive learning experience.",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}